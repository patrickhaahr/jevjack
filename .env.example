# typesafe-ai/sdk reads TYPESAFE_API_KEY from the environment.
# Already set in the shell here; leave unset to run with MODEL=mock.
TYPESAFE_API_KEY=

# mock | jev  (mock = basic-strategy heuristic, no API calls)
MODEL=mock

# on | off  — whether Jev receives the code-computed basic-strategy advice in
# its state. off makes Jev decide free-form (more deviations, worse results).
ADVICE=on

PORT=3000
